% Exception handling.  m3core implements RTException in one of two ways;
% "ex" means a variant of exception handling.  The names are historical:
% both involve frames, a stack and a walker, so here is what each one is.
%
% ex_frame: setjmp/longjmp and a per-thread list of handler frames.
%   The frames are small records (EF..EF4 in ex_frame/RTExFrame.m3) declared
%   as locals in the activation record of the procedure containing the
%   construct; they are not a separate stack.  Compiler-inserted calls to
%   PushEFrame and PopEFrame link and unlink them in a per-thread list
%   (RTThread.GetCurrentHandlers).  A frame is pushed only for TRY EXCEPT
%   (which also does a setjmp, the main cost), TRY FINALLY, LOCK, and a
%   procedure whose RAISES clause is narrower than ANY and whose body might
%   raise something outside it.  That cost is paid on entering and leaving
%   each such construct, whether or not anything is raised.  RAISE walks the
%   list in two passes: the first finds the handler, checking RAISES clauses
%   on the way; the second releases locks, enters each FINALLY clause by
%   longjmp (the clause resumes the raise when it finishes), and longjmps
%   into the handler.  The walker is RTExFrame, in m3core.
%
% ex_stack: C++ exceptions.  No handler list is kept at run time.  The C
%   backend emits C++ try/catch for the same constructs (MSIR's LLVM lowering
%   emits invoke/landingpad), and the C++ compiler emits unwind tables that
%   say, for each code address, how to recover the caller's frame and where
%   the landing pads are.  RAISE throws a C++ exception (RTStack__ThrowM3Exc
%   in ex_stack/RTExStackImpl.h).  The C++ runtime's unwinder (libunwind in
%   libSystem on macOS; libunwind or libgcc_s on Linux) walks the ordinary
%   activation-record stack using those tables, and at each landing pad
%   compiler-generated code asks RTExStack whether the handler matches.
%   Entering and leaving a protected region costs nothing beyond table space
%   and some limits on optimization; a raise costs much more than a longjmp.
%   ("stack" means whatever the C++ implementation does: 32-bit Windows C++
%   EH, for one, is itself frame-based, with a per-thread list.)
%
% In short: ex_frame pays on every protected region and raises cheaply;
% ex_stack pays nothing until something is raised, then pays a lot.
%
% ex_stack is used when the config asks for it (M3_USE_STACK_WALKER) and the
% backend is C, whose generated C++ carries the try/catch; otherwise
% ex_frame.  Raising under ex_stack is a C++ throw and needs nothing
% target-specific.
M3CORE_EX_STACK = FALSE
M3CORE_EX_STACK_LLVM = FALSE
if defined ("M3_USE_STACK_WALKER")
  if M3_USE_STACK_WALKER and defined ("M3_BACKEND_MODE")
    if equal (M3_BACKEND_MODE, "C")
      M3CORE_EX_STACK = TRUE
    end
    if IsBackendLlvm()
      M3CORE_EX_STACK = TRUE
      M3CORE_EX_STACK_LLVM = TRUE
    end
  end
end

%
% Targets requiring libunwind, for use only to dump stacks.
% No target uses libunwind directly for exception handling (see above).
%
% TODO: Windows locally can provide libunwind over RtlVirtualUnwind,
% or rather CaptureStackBackTrace for this narrow use.
% ARM64|ARM64_DARWIN provides libunwind "builtin" (libSystem).
%
readonly HAS_LIBUNWIND = {
  "AMD64_LINUX"   : TRUE,
}

% Targets with a libunwind stack walker (RTStackC.c in the
% target's directory), used only for stack dumps under ex_stack.  Elsewhere,
% and with ex_frame, the RTStack routines are stubs (no_walker).
readonly HAS_STACK_WALKER = {
% "ALPHA_OSF"  : TRUE,
% "DS3100"     : TRUE,
% "SOLgnu"     : TRUE,
% "SOLsun"     : TRUE,
 "AMD64_LINUX"   : TRUE,
 "AMD64_DARWIN"  : TRUE,
 "ARM64_DARWIN"  : TRUE,
}
M3CORE_TARGET_WALKER = M3CORE_EX_STACK and HAS_STACK_WALKER contains TARGET

include_dir ("common")

if equal (OS_TYPE, "WIN32") or equal (TARGET_OS, "CYGWIN")
  include_dir ("WIN32")
else
  include_dir (OS_TYPE) % Win32 or Posix
end

%proc FileExists(a) is
%    return not stale (a, a)
%end
%
%if (equal(TARGET, "NT386")
%    or equal(TARGET, "I386_NT")
%    or equal(TARGET, "AMD64_NT")
%    or equal(TARGET, "IA64_NT")
%    or equal(TARGET, "ARM_NT")
%    or equal(TARGET, "ARM64_NT")
%    ) and equal(OS_TYPE, "POSIX")
%  % nothing -- no user thread support (Cygwin?)
%else
%    if FileExists(path() & "/" & TARGET & "/m3makefile")
%        include_dir (TARGET)
%    else
%        % nothing -- no user thread support
%    end
%end

if M3CORE_EX_STACK
  if M3CORE_EX_STACK_LLVM
    include_dir ("ex_stack_llvm")
  else
    include_dir ("ex_stack")
  end
else
  include_dir ("ex_frame")
end
if M3CORE_TARGET_WALKER
  if HAS_LIBUNWIND contains TARGET
    import_sys_lib ("UNWIND")
  end
  include_dir ("walker")
else
  include_dir ("no_walker")
end
