MODULE bitfield;
<*NOWARN*>IMPORT Cstdint, Word, Long;

(* define some types *)

<*NOWARN*>TYPE FLOAT32 = REAL;
<*NOWARN*>TYPE FLOAT64 = LONGREAL;
<*NOWARN*>TYPE INT8 = Cstdint.int8_t;
<*NOWARN*>TYPE UINT64 = Cstdint.uint64_t;
<*NOWARN*>TYPE INT32 = Cstdint.int32_t;
<*NOWARN*>TYPE UINT16 = Cstdint.uint16_t;
<*NOWARN*>TYPE INT64 = Cstdint.int64_t;
<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=865;
<*NOWARN*> CONST ku64:UINT64=866L;
<*NOWARN*> CONST kf64:FLOAT64=867.868d0;
<*NOWARN*> CONST ki32:INT32=869;
<*NOWARN*> CONST kLC:LONGCARD=870L;
<*NOWARN*> CONST ku16:UINT16=871;
<*NOWARN*> CONST kI:INTEGER=872;
<*NOWARN*> CONST ki64:INT64=873L;
<*NOWARN*> CONST kf32:FLOAT32=874.875e0;
<*NOWARN*> CONST ki16:INT16=876;
<*NOWARN*> CONST kC:CARDINAL=877;
<*NOWARN*> CONST ku32:UINT32=878;
<*NOWARN*> CONST ku8:UINT8=879;
<*NOWARN*> CONST kL:LONGINT=880L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=881;
<*NOWARN*> VAR vu64:UINT64:=882L;
<*NOWARN*> VAR vf64:FLOAT64:=883.884d0;
<*NOWARN*> VAR vi32:INT32:=885;
<*NOWARN*> VAR vLC:LONGCARD:=886L;
<*NOWARN*> VAR vu16:UINT16:=887;
<*NOWARN*> VAR vI:INTEGER:=888;
<*NOWARN*> VAR vi64:INT64:=889L;
<*NOWARN*> VAR vf32:FLOAT32:=890.891e0;
<*NOWARN*> VAR vi16:INT16:=892;
<*NOWARN*> VAR vC:CARDINAL:=893;
<*NOWARN*> VAR vu32:UINT32:=894;
<*NOWARN*> VAR vu8:UINT8:=895;
<*NOWARN*> VAR vL:LONGINT:=896L;
<*NOWARN*>VAR offset, count:CARDINAL;

(* bit field get and set *)

<*NOWARN*>TYPE BitField_offset1_count1 = RECORD 
 offset:BITS 1 FOR  [0 .. Word.RightShift(Word.Not(0), 63)];
 value:BITS 1 FOR  [0 .. Word.RightShift(Word.Not(0), 63)];
END;
<*NOWARN*> PROCEDURE read_var_BitField_offset1_count1(a:BitField_offset1_count1):INTEGER=
             BEGIN RETURN a.value END read_var_BitField_offset1_count1;
<*NOWARN*> PROCEDURE write_var_BitField_offset1_count1(VAR a:BitField_offset1_count1;b:INTEGER)=
              BEGIN a.value := b END write_var_BitField_offset1_count1;
