<*NOWARN*> CONST ku32:UINT32=430;
<*NOWARN*> CONST ku8:UINT8=431;
<*NOWARN*> CONST kL:LONGINT=432L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=433;
<*NOWARN*> VAR vu64:UINT64:=434L;
<*NOWARN*> VAR vf64:FLOAT64:=435.436d0;
<*NOWARN*> VAR vi32:INT32:=437;
