<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=417;
<*NOWARN*> CONST ku64:UINT64=418L;
<*NOWARN*> CONST kf64:FLOAT64=419.420d0;
<*NOWARN*> CONST ki32:INT32=421;
<*NOWARN*> CONST kLC:LONGCARD=422L;
<*NOWARN*> CONST ku16:UINT16=423;
<*NOWARN*> CONST kI:INTEGER=424;
<*NOWARN*> CONST ki64:INT64=425L;
