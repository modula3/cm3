<*NOWARN*> CONST kC:CARDINAL=973;
<*NOWARN*> CONST ku32:UINT32=974;
<*NOWARN*> CONST ku8:UINT8=975;
<*NOWARN*> CONST kL:LONGINT=976L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=977;
<*NOWARN*> VAR vu64:UINT64:=978L;
<*NOWARN*> VAR vf64:FLOAT64:=979.980d0;
<*NOWARN*> VAR vi32:INT32:=981;
