<*NOWARN*>PROCEDURE LE_param_i8_i32(a:INT8;b:INT32):BOOLEAN=BEGIN RETURN a <= b;END LE_param_i8_i32;
<*NOWARN*>PROCEDURE uLE_var_i8_LC():BOOLEAN=BEGIN RETURN Long.LE(VAL(vi8, LONGINT),vLC);END uLE_var_i8_LC;
<*NOWARN*>PROCEDURE LE_var_i8_LC():BOOLEAN=BEGIN RETURN VAL(vi8, LONGINT) <= vLC;END LE_var_i8_LC;
