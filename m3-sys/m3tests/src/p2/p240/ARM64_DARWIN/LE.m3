MODULE LE;
<*NOWARN*>IMPORT Cstdint, Word, Long;

(* define some types *)

<*NOWARN*>TYPE FLOAT32 = REAL;
<*NOWARN*>TYPE FLOAT64 = LONGREAL;
<*NOWARN*>TYPE INT8 = Cstdint.int8_t;
<*NOWARN*>TYPE UINT64 = Cstdint.uint64_t;
<*NOWARN*>TYPE INT32 = Cstdint.int32_t;
<*NOWARN*>TYPE UINT16 = Cstdint.uint16_t;
<*NOWARN*>TYPE INT64 = Cstdint.int64_t;
<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=321;
<*NOWARN*> CONST ku64:UINT64=322L;
<*NOWARN*> CONST kf64:FLOAT64=323.324d0;
<*NOWARN*> CONST ki32:INT32=325;
<*NOWARN*> CONST kLC:LONGCARD=326L;
<*NOWARN*> CONST ku16:UINT16=327;
<*NOWARN*> CONST kI:INTEGER=328;
<*NOWARN*> CONST ki64:INT64=329L;
<*NOWARN*> CONST kf32:FLOAT32=330.331e0;
<*NOWARN*> CONST ki16:INT16=332;
<*NOWARN*> CONST kC:CARDINAL=333;
<*NOWARN*> CONST ku32:UINT32=334;
<*NOWARN*> CONST ku8:UINT8=335;
<*NOWARN*> CONST kL:LONGINT=336L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=337;
<*NOWARN*> VAR vu64:UINT64:=338L;
<*NOWARN*> VAR vf64:FLOAT64:=339.340d0;
<*NOWARN*> VAR vi32:INT32:=341;
<*NOWARN*> VAR vLC:LONGCARD:=342L;
<*NOWARN*> VAR vu16:UINT16:=343;
<*NOWARN*> VAR vI:INTEGER:=344;
<*NOWARN*> VAR vi64:INT64:=345L;
<*NOWARN*> VAR vf32:FLOAT32:=346.347e0;
<*NOWARN*> VAR vi16:INT16:=348;
<*NOWARN*> VAR vC:CARDINAL:=349;
<*NOWARN*> VAR vu32:UINT32:=350;
<*NOWARN*> VAR vu8:UINT8:=351;
<*NOWARN*> VAR vL:LONGINT:=352L;
<*NOWARN*>VAR offset, count:CARDINAL;

(* LE *)

<*NOWARN*>PROCEDURE uLE_var_i8_i8():BOOLEAN=BEGIN RETURN Word.LE(vi8,vi8);END uLE_var_i8_i8;
<*NOWARN*>PROCEDURE LE_var_i8_i8():BOOLEAN=BEGIN RETURN vi8 <= vi8;END LE_var_i8_i8;
<*NOWARN*>PROCEDURE uLE_param_i8_i8(a:INT8;b:INT8):BOOLEAN=BEGIN RETURN Word.LE(a,b);END uLE_param_i8_i8;
<*NOWARN*>PROCEDURE LE_param_i8_i8(a:INT8;b:INT8):BOOLEAN=BEGIN RETURN a <= b;END LE_param_i8_i8;
<*NOWARN*>PROCEDURE uLE_var_i8_u64():BOOLEAN=BEGIN RETURN Long.LE(VAL(vi8, LONGINT),vu64);END uLE_var_i8_u64;
<*NOWARN*>PROCEDURE LE_var_i8_u64():BOOLEAN=BEGIN RETURN VAL(vi8, LONGINT) <= vu64;END LE_var_i8_u64;
<*NOWARN*>PROCEDURE uLE_param_i8_u64(a:INT8;b:UINT64):BOOLEAN=BEGIN RETURN Long.LE(VAL(a, LONGINT),b);END uLE_param_i8_u64;
<*NOWARN*>PROCEDURE LE_param_i8_u64(a:INT8;b:UINT64):BOOLEAN=BEGIN RETURN VAL(a, LONGINT) <= b;END LE_param_i8_u64;
