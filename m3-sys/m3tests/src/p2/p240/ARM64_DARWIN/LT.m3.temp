MODULE LT;
<*NOWARN*>IMPORT Cstdint, Word, Long;

(* define some types *)

<*NOWARN*>TYPE FLOAT32 = REAL;
<*NOWARN*>TYPE FLOAT64 = LONGREAL;
<*NOWARN*>TYPE INT8 = Cstdint.int8_t;
<*NOWARN*>TYPE UINT64 = Cstdint.uint64_t;
<*NOWARN*>TYPE INT32 = Cstdint.int32_t;
<*NOWARN*>TYPE UINT16 = Cstdint.uint16_t;
<*NOWARN*>TYPE INT64 = Cstdint.int64_t;
<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=289;
<*NOWARN*> CONST ku64:UINT64=290L;
<*NOWARN*> CONST kf64:FLOAT64=291.292d0;
<*NOWARN*> CONST ki32:INT32=293;
<*NOWARN*> CONST kLC:LONGCARD=294L;
<*NOWARN*> CONST ku16:UINT16=295;
<*NOWARN*> CONST kI:INTEGER=296;
<*NOWARN*> CONST ki64:INT64=297L;
<*NOWARN*> CONST kf32:FLOAT32=298.299e0;
<*NOWARN*> CONST ki16:INT16=300;
<*NOWARN*> CONST kC:CARDINAL=301;
<*NOWARN*> CONST ku32:UINT32=302;
<*NOWARN*> CONST ku8:UINT8=303;
<*NOWARN*> CONST kL:LONGINT=304L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=305;
<*NOWARN*> VAR vu64:UINT64:=306L;
<*NOWARN*> VAR vf64:FLOAT64:=307.308d0;
<*NOWARN*> VAR vi32:INT32:=309;
<*NOWARN*> VAR vLC:LONGCARD:=310L;
<*NOWARN*> VAR vu16:UINT16:=311;
<*NOWARN*> VAR vI:INTEGER:=312;
<*NOWARN*> VAR vi64:INT64:=313L;
<*NOWARN*> VAR vf32:FLOAT32:=314.315e0;
<*NOWARN*> VAR vi16:INT16:=316;
<*NOWARN*> VAR vC:CARDINAL:=317;
<*NOWARN*> VAR vu32:UINT32:=318;
<*NOWARN*> VAR vu8:UINT8:=319;
<*NOWARN*> VAR vL:LONGINT:=320L;
<*NOWARN*>VAR offset, count:CARDINAL;

(* LT *)

<*NOWARN*>PROCEDURE uLT_var_i8_i8():BOOLEAN=BEGIN RETURN Word.LT(vi8,vi8);END uLT_var_i8_i8;
<*NOWARN*>PROCEDURE LT_var_i8_i8():BOOLEAN=BEGIN RETURN vi8 < vi8;END LT_var_i8_i8;
<*NOWARN*>PROCEDURE uLT_param_i8_i8(a:INT8;b:INT8):BOOLEAN=BEGIN RETURN Word.LT(a,b);END uLT_param_i8_i8;
<*NOWARN*>PROCEDURE LT_param_i8_i8(a:INT8;b:INT8):BOOLEAN=BEGIN RETURN a < b;END LT_param_i8_i8;
<*NOWARN*>PROCEDURE uLT_var_i8_u64():BOOLEAN=BEGIN RETURN Long.LT(VAL(vi8, LONGINT),vu64);END uLT_var_i8_u64;
<*NOWARN*>PROCEDURE LT_var_i8_u64():BOOLEAN=BEGIN RETURN VAL(vi8, LONGINT) < vu64;END LT_var_i8_u64;
<*NOWARN*>PROCEDURE uLT_param_i8_u64(a:INT8;b:UINT64):BOOLEAN=BEGIN RETURN Long.LT(VAL(a, LONGINT),b);END uLT_param_i8_u64;
<*NOWARN*>PROCEDURE LT_param_i8_u64(a:INT8;b:UINT64):BOOLEAN=BEGIN RETURN VAL(a, LONGINT) < b;END LT_param_i8_u64;
<*NOWARN*>PROCEDURE uLT_var_i8_i32():BOOLEAN=BEGIN RETURN Word.LT(vi8,vi32);END uLT_var_i8_i32;
<*NOWARN*>PROCEDURE LT_var_i8_i32():BOOLEAN=BEGIN RETURN vi8 < vi32;END LT_var_i8_i32;
<*NOWARN*>PROCEDURE uLT_param_i8_i32(a:INT8;b:INT32):BOOLEAN=BEGIN RETURN Word.LT(a,b);END uLT_param_i8_i32;
<*NOWARN*>PROCEDURE LT_param_i8_i32(a:INT8;b:INT32):BOOLEAN=BEGIN RETURN a < b;END LT_param_i8_i32;
<*NOWARN*>PROCEDURE uLT_var_i8_LC():BOOLEAN=BEGIN RETURN Long.LT(VAL(vi8, LONGINT),vLC);END uLT_var_i8_LC;
<*NOWARN*>PROCEDURE LT_var_i8_LC():BOOLEAN=BEGIN RETURN VAL(vi8, LONGINT) < vLC;END LT_var_i8_LC;
<*NOWARN*>PROCEDURE uLT_param_i8_LC(a:INT8;b:LONGCARD):BOOLEAN=BEGIN RETURN Long.LT(VAL(a, LONGINT),b);END uLT_param_i8_LC;
