(* Plus *)

<*NOWARN*>PROCEDURE uPlus_var_i8_i8():Word.T=BEGIN RETURN Word.Plus(vi8,vi8);END uPlus_var_i8_i8;
<*NOWARN*>PROCEDURE Plus_var_i8_i8():INT8=BEGIN RETURN vi8 + vi8;END Plus_var_i8_i8;
