MODULE Mod;
<*NOWARN*>IMPORT Cstdint, Word, Long;

(* define some types *)

<*NOWARN*>TYPE FLOAT32 = REAL;
<*NOWARN*>TYPE FLOAT64 = LONGREAL;
<*NOWARN*>TYPE INT8 = Cstdint.int8_t;
<*NOWARN*>TYPE UINT64 = Cstdint.uint64_t;
<*NOWARN*>TYPE INT32 = Cstdint.int32_t;
<*NOWARN*>TYPE UINT16 = Cstdint.uint16_t;
<*NOWARN*>TYPE INT64 = Cstdint.int64_t;
<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=257;
<*NOWARN*> CONST ku64:UINT64=258L;
<*NOWARN*> CONST kf64:FLOAT64=259.260d0;
<*NOWARN*> CONST ki32:INT32=261;
<*NOWARN*> CONST kLC:LONGCARD=262L;
<*NOWARN*> CONST ku16:UINT16=263;
<*NOWARN*> CONST kI:INTEGER=264;
<*NOWARN*> CONST ki64:INT64=265L;
<*NOWARN*> CONST kf32:FLOAT32=266.267e0;
<*NOWARN*> CONST ki16:INT16=268;
<*NOWARN*> CONST kC:CARDINAL=269;
<*NOWARN*> CONST ku32:UINT32=270;
<*NOWARN*> CONST ku8:UINT8=271;
<*NOWARN*> CONST kL:LONGINT=272L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=273;
<*NOWARN*> VAR vu64:UINT64:=274L;
<*NOWARN*> VAR vf64:FLOAT64:=275.276d0;
<*NOWARN*> VAR vi32:INT32:=277;
<*NOWARN*> VAR vLC:LONGCARD:=278L;
<*NOWARN*> VAR vu16:UINT16:=279;
<*NOWARN*> VAR vI:INTEGER:=280;
<*NOWARN*> VAR vi64:INT64:=281L;
<*NOWARN*> VAR vf32:FLOAT32:=282.283e0;
<*NOWARN*> VAR vi16:INT16:=284;
<*NOWARN*> VAR vC:CARDINAL:=285;
<*NOWARN*> VAR vu32:UINT32:=286;
<*NOWARN*> VAR vu8:UINT8:=287;
<*NOWARN*> VAR vL:LONGINT:=288L;
<*NOWARN*>VAR offset, count:CARDINAL;

(* Mod *)

<*NOWARN*>PROCEDURE uMod_var_i8_i8():Word.T=BEGIN RETURN Word.Mod(vi8,vi8);END uMod_var_i8_i8;
<*NOWARN*>PROCEDURE Mod_var_i8_i8():INT8=BEGIN RETURN vi8 MOD vi8;END Mod_var_i8_i8;
<*NOWARN*>PROCEDURE uMod_param_i8_i8(a:INT8;b:INT8):Word.T=BEGIN RETURN Word.Mod(a,b);END uMod_param_i8_i8;
<*NOWARN*>PROCEDURE Mod_param_i8_i8(a:INT8;b:INT8):INT8=BEGIN RETURN a MOD b;END Mod_param_i8_i8;
<*NOWARN*>PROCEDURE uMod_var_i8_u64():Long.T=BEGIN RETURN Long.Mod(VAL(vi8, LONGINT),vu64);END uMod_var_i8_u64;
<*NOWARN*>PROCEDURE Mod_var_i8_u64():LONGINT=BEGIN RETURN VAL(vi8, LONGINT) MOD vu64;END Mod_var_i8_u64;
<*NOWARN*>PROCEDURE uMod_param_i8_u64(a:INT8;b:UINT64):Long.T=BEGIN RETURN Long.Mod(VAL(a, LONGINT),b);END uMod_param_i8_u64;
<*NOWARN*>PROCEDURE Mod_param_i8_u64(a:INT8;b:UINT64):LONGINT=BEGIN RETURN VAL(a, LONGINT) MOD b;END Mod_param_i8_u64;
