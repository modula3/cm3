MODULE Minus;
<*NOWARN*>IMPORT Cstdint, Word, Long;

(* define some types *)

<*NOWARN*>TYPE FLOAT32 = REAL;
<*NOWARN*>TYPE FLOAT64 = LONGREAL;
<*NOWARN*>TYPE INT8 = Cstdint.int8_t;
<*NOWARN*>TYPE UINT64 = Cstdint.uint64_t;
<*NOWARN*>TYPE INT32 = Cstdint.int32_t;
<*NOWARN*>TYPE UINT16 = Cstdint.uint16_t;
<*NOWARN*>TYPE INT64 = Cstdint.int64_t;
<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=193;
<*NOWARN*> CONST ku64:UINT64=194L;
<*NOWARN*> CONST kf64:FLOAT64=195.196d0;
<*NOWARN*> CONST ki32:INT32=197;
<*NOWARN*> CONST kLC:LONGCARD=198L;
<*NOWARN*> CONST ku16:UINT16=199;
<*NOWARN*> CONST kI:INTEGER=200;
<*NOWARN*> CONST ki64:INT64=201L;
<*NOWARN*> CONST kf32:FLOAT32=202.203e0;
<*NOWARN*> CONST ki16:INT16=204;
<*NOWARN*> CONST kC:CARDINAL=205;
<*NOWARN*> CONST ku32:UINT32=206;
<*NOWARN*> CONST ku8:UINT8=207;
<*NOWARN*> CONST kL:LONGINT=208L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=209;
<*NOWARN*> VAR vu64:UINT64:=210L;
<*NOWARN*> VAR vf64:FLOAT64:=211.212d0;
<*NOWARN*> VAR vi32:INT32:=213;
<*NOWARN*> VAR vLC:LONGCARD:=214L;
<*NOWARN*> VAR vu16:UINT16:=215;
<*NOWARN*> VAR vI:INTEGER:=216;
<*NOWARN*> VAR vi64:INT64:=217L;
<*NOWARN*> VAR vf32:FLOAT32:=218.219e0;
<*NOWARN*> VAR vi16:INT16:=220;
<*NOWARN*> VAR vC:CARDINAL:=221;
<*NOWARN*> VAR vu32:UINT32:=222;
<*NOWARN*> VAR vu8:UINT8:=223;
<*NOWARN*> VAR vL:LONGINT:=224L;
<*NOWARN*>VAR offset, count:CARDINAL;

(* Minus *)

<*NOWARN*>PROCEDURE uMinus_var_i8_i8():Word.T=BEGIN RETURN Word.Minus(vi8,vi8);END uMinus_var_i8_i8;
<*NOWARN*>PROCEDURE Minus_var_i8_i8():INT8=BEGIN RETURN vi8 - vi8;END Minus_var_i8_i8;
<*NOWARN*>PROCEDURE uMinus_param_i8_i8(a:INT8;b:INT8):Word.T=BEGIN RETURN Word.Minus(a,b);END uMinus_param_i8_i8;
<*NOWARN*>PROCEDURE Minus_param_i8_i8(a:INT8;b:INT8):INT8=BEGIN RETURN a - b;END Minus_param_i8_i8;
<*NOWARN*>PROCEDURE uMinus_var_i8_u64():Long.T=BEGIN RETURN Long.Minus(VAL(vi8, LONGINT),vu64);END uMinus_var_i8_u64;
<*NOWARN*>PROCEDURE Minus_var_i8_u64():LONGINT=BEGIN RETURN VAL(vi8, LONGINT) - vu64;END Minus_var_i8_u64;
<*NOWARN*>PROCEDURE uMinus_param_i8_u64(a:INT8;b:UINT64):Long.T=BEGIN RETURN Long.Minus(VAL(a, LONGINT),b);END uMinus_param_i8_u64;
<*NOWARN*>PROCEDURE Minus_param_i8_u64(a:INT8;b:UINT64):LONGINT=BEGIN RETURN VAL(a, LONGINT) - b;END Minus_param_i8_u64;
<*NOWARN*>PROCEDURE uMinus_var_i8_i32():Word.T=BEGIN RETURN Word.Minus(vi8,vi32);END uMinus_var_i8_i32;
