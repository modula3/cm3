<*NOWARN*>PROCEDURE Minus_param_i8_i32(a:INT8;b:INT32):INT8=BEGIN RETURN a - b;END Minus_param_i8_i32;
<*NOWARN*>PROCEDURE uMinus_var_i8_LC():Long.T=BEGIN RETURN Long.Minus(VAL(vi8, LONGINT),vLC);END uMinus_var_i8_LC;
<*NOWARN*>PROCEDURE Minus_var_i8_LC():LONGINT=BEGIN RETURN VAL(vi8, LONGINT) - vLC;END Minus_var_i8_LC;
