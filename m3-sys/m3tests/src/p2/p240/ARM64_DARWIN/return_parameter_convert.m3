(* constants *)

<*NOWARN*> CONST ki8:INT8=97;
<*NOWARN*> CONST ku64:UINT64=98L;
<*NOWARN*> CONST kf64:FLOAT64=99.100d0;
<*NOWARN*> CONST ki32:INT32=101;
<*NOWARN*> CONST kLC:LONGCARD=102L;
