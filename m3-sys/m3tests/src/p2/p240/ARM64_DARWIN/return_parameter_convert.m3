<*NOWARN*> CONST ku32:UINT32=110;
<*NOWARN*> CONST ku8:UINT8=111;
<*NOWARN*> CONST kL:LONGINT=112L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=113;
<*NOWARN*> VAR vu64:UINT64:=114L;
<*NOWARN*> VAR vf64:FLOAT64:=115.116d0;
<*NOWARN*> VAR vi32:INT32:=117;
