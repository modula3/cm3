MODULE insert_constant_count;
<*NOWARN*>IMPORT Cstdint, Word, Long;

(* define some types *)

<*NOWARN*>TYPE FLOAT32 = REAL;
<*NOWARN*>TYPE FLOAT64 = LONGREAL;
<*NOWARN*>TYPE INT8 = Cstdint.int8_t;
<*NOWARN*>TYPE UINT64 = Cstdint.uint64_t;
<*NOWARN*>TYPE INT32 = Cstdint.int32_t;
<*NOWARN*>TYPE UINT16 = Cstdint.uint16_t;
<*NOWARN*>TYPE INT64 = Cstdint.int64_t;
<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=993;
<*NOWARN*> CONST ku64:UINT64=994L;
<*NOWARN*> CONST kf64:FLOAT64=995.996d0;
<*NOWARN*> CONST ki32:INT32=997;
<*NOWARN*> CONST kLC:LONGCARD=998L;
<*NOWARN*> CONST ku16:UINT16=999;
<*NOWARN*> CONST kI:INTEGER=1000;
<*NOWARN*> CONST ki64:INT64=1001L;
<*NOWARN*> CONST kf32:FLOAT32=1002.1003e0;
<*NOWARN*> CONST ki16:INT16=1004;
<*NOWARN*> CONST kC:CARDINAL=1005;
<*NOWARN*> CONST ku32:UINT32=1006;
<*NOWARN*> CONST ku8:UINT8=1007;
<*NOWARN*> CONST kL:LONGINT=1008L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=1009;
<*NOWARN*> VAR vu64:UINT64:=1010L;
<*NOWARN*> VAR vf64:FLOAT64:=1011.1012d0;
<*NOWARN*> VAR vi32:INT32:=1013;
<*NOWARN*> VAR vLC:LONGCARD:=1014L;
<*NOWARN*> VAR vu16:UINT16:=1015;
<*NOWARN*> VAR vI:INTEGER:=1016;
<*NOWARN*> VAR vi64:INT64:=1017L;
<*NOWARN*> VAR vf32:FLOAT32:=1018.1019e0;
<*NOWARN*> VAR vi16:INT16:=1020;
<*NOWARN*> VAR vC:CARDINAL:=1021;
<*NOWARN*> VAR vu32:UINT32:=1022;
<*NOWARN*> VAR vu8:UINT8:=1023;
<*NOWARN*> VAR vL:LONGINT:=1024L;
<*NOWARN*>VAR offset, count:CARDINAL;

(* insert with constant count *)

