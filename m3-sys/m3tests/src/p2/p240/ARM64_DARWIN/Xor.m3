MODULE Xor;
<*NOWARN*>IMPORT Cstdint, Word, Long;

(* define some types *)

<*NOWARN*>TYPE FLOAT32 = REAL;
<*NOWARN*>TYPE FLOAT64 = LONGREAL;
<*NOWARN*>TYPE INT8 = Cstdint.int8_t;
<*NOWARN*>TYPE UINT64 = Cstdint.uint64_t;
<*NOWARN*>TYPE INT32 = Cstdint.int32_t;
<*NOWARN*>TYPE UINT16 = Cstdint.uint16_t;
<*NOWARN*>TYPE INT64 = Cstdint.int64_t;
<*NOWARN*>TYPE INT16 = Cstdint.int16_t;
<*NOWARN*>TYPE UINT32 = Cstdint.uint32_t;
<*NOWARN*>TYPE UINT8 = Cstdint.uint8_t;

(* constants *)

<*NOWARN*> CONST ki8:INT8=481;
<*NOWARN*> CONST ku64:UINT64=482L;
<*NOWARN*> CONST kf64:FLOAT64=483.484d0;
<*NOWARN*> CONST ki32:INT32=485;
<*NOWARN*> CONST kLC:LONGCARD=486L;
<*NOWARN*> CONST ku16:UINT16=487;
<*NOWARN*> CONST kI:INTEGER=488;
<*NOWARN*> CONST ki64:INT64=489L;
<*NOWARN*> CONST kf32:FLOAT32=490.491e0;
<*NOWARN*> CONST ki16:INT16=492;
<*NOWARN*> CONST kC:CARDINAL=493;
<*NOWARN*> CONST ku32:UINT32=494;
<*NOWARN*> CONST ku8:UINT8=495;
<*NOWARN*> CONST kL:LONGINT=496L;

(* variables *)

<*NOWARN*> VAR vi8:INT8:=497;
<*NOWARN*> VAR vu64:UINT64:=498L;
<*NOWARN*> VAR vf64:FLOAT64:=499.500d0;
<*NOWARN*> VAR vi32:INT32:=501;
<*NOWARN*> VAR vLC:LONGCARD:=502L;
<*NOWARN*> VAR vu16:UINT16:=503;
<*NOWARN*> VAR vI:INTEGER:=504;
<*NOWARN*> VAR vi64:INT64:=505L;
<*NOWARN*> VAR vf32:FLOAT32:=506.507e0;
<*NOWARN*> VAR vi16:INT16:=508;
<*NOWARN*> VAR vC:CARDINAL:=509;
<*NOWARN*> VAR vu32:UINT32:=510;
<*NOWARN*> VAR vu8:UINT8:=511;
<*NOWARN*> VAR vL:LONGINT:=512L;
<*NOWARN*>VAR offset, count:CARDINAL;

(* Xor *)

<*NOWARN*>PROCEDURE uXor_var_i8_i8():Word.T=BEGIN RETURN Word.Xor(vi8,vi8);END uXor_var_i8_i8;
<*NOWARN*>PROCEDURE uXor_param_i8_i8(a:INT8;b:INT8):Word.T=BEGIN RETURN Word.Xor(a,b);END uXor_param_i8_i8;
<*NOWARN*>PROCEDURE uXor_var_i8_u64():Long.T=BEGIN RETURN Long.Xor(VAL(vi8, LONGINT),vu64);END uXor_var_i8_u64;
<*NOWARN*>PROCEDURE uXor_param_i8_u64(a:INT8;b:UINT64):Long.T=BEGIN RETURN Long.Xor(VAL(a, LONGINT),b);END uXor_param_i8_u64;
