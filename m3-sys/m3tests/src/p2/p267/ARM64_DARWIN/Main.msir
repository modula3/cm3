module Main

proc Main__Clean1(a.r: gc_ref void) -> void
entry:
  %r.slot = alloca gc_ref void
  store a.r, %r.slot
  call RTIO__PutText("Clean1:")
  %t1 = load gc_ref void, %r.slot
  call RTIO__PutAddr(%t1, 0)
  call RTIO__PutText("\0a")
  call RTIO__Flush()
  ret

proc Main__Clean2(a.r: gc_ref void) -> void
entry:
  %r.slot = alloca gc_ref void
  store a.r, %r.slot
  call RTIO__PutText("Clean2:")
  %t1 = load gc_ref void, %r.slot
  call RTIO__PutAddr(%t1, 0)
