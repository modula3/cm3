readonly TARGET = "AMD64_LINUX" % code generation target
readonly GNU_PLATFORM = "amd64-linux" % "cpu-os" string for GNU

SYSTEM_CC = "gcc -g -m64 -fPIC" % C compiler
SYSTEM_CXXC = "g++ -g -m64 -fPIC" % C++ compiler

readonly SYSTEM_ASM = "as --64" % Assembler

% Enable C++ zero-cost exception handling (ex_stack).
% Comment out to revert to the native GCC backend (mode "3").
% Requires libunwind-dev: apt-get install libunwind-dev
%M3_USE_STACK_WALKER = TRUE

% ex_stack requires the C backend and g++ with -x c++.
% M3_BACKEND_MODE must be set before includes so cm3cfg.common's
% "if not defined" guard fires correctly.
if defined("M3_USE_STACK_WALKER")
  M3_BACKEND_MODE = "C"
end

include("AMD64.common")
include("Linux.common")

SYSTEM_LIBS{"LIBC"} += [ "-lquadmath" ]

if defined("M3_USE_STACK_WALKER")
  % RTStackC.c and M3C.m3-generated files use C++ EH (catch/_M3Exc/throw),
  % so SYSTEM_CC must invoke the C++ compiler with -x c++.
  SYSTEM_CC = "g++ -g -m64 -fPIC -x c++"
  SYSTEM_LIBS{"UNWIND"} = [ "-lunwind-x86_64", "-lunwind" ]
end

% M3C declares EXTENDED as _Float128, which g++ < 13 (Debian 12) lacks in C++;
% __float128 is the same IEEE binary128 type on x86-64.
if not equal(try_exec("@echo '_Float128 x;' | g++ -x c++ -fsyntax-only - >/dev/null 2>&1"), 0)
  SYSTEM_CC = SYSTEM_CC & " -D_Float128=__float128"
  SYSTEM_CXXC = SYSTEM_CXXC & " -D_Float128=__float128"
end
